<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Football&CO</title>
    <!--CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="stylesheets/style.css" rel="stylesheet">
    <!--JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"></script>

</head>

<body>

<header class="p-3 text-bg-dark">
    <div class="container d-flex justify-content-between align-items-center">
        <a href="/" class="d-flex align-items-center text-white text-decoration-none">
            <img src="images/logo_giallo.png" alt="Logo sito" width="32">
            <span class="ms-2">Home</span>
        </a>
    </div>
</header>

<main class="form-signin w-100">
    <form style="max-width: 50%; margin: 0 auto;">
        <h1 class="h3 mb-3 fw-normal text-center">Login</h1>
        <div class="form-floating">
            <input type="email" class="form-control" id="emailInput" placeholder="name@example.com" autocomplete="email">
            <label for="emailInput">Email*</label>
        </div>
        <div class="form-floating">
            <input type="password" class="form-control" id="passwordInput" placeholder="Password" autocomplete="current-password">
            <label for="passwordInput">Password*</label>
        </div>
        <p>* campi obbligatori</p>
        <a href="/" class="btn btn-primary w-100 py-2">Login</a>

        <div class="a-divider a-divider-break">
            <p>Vuoi creare un account?</p>
            <a href="/signup" class="btn btn-secondary w-100 py-2">Sign up</a>
        </div>
    </form>
</main>
</body>
</html>