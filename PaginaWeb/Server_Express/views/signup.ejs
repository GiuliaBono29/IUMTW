<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Football&CO sign up</title>
    <!--CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="stylesheets/style.css" rel="stylesheet">
    <!--JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="javascripts/script.js"></script>

</head>

<body onload="init()">
<a href="#maincontent" class="skip-link">Salta al contenuto principale</a>
<header class="p-3 text-bg-dark">
    <div class="container d-flex justify-content-between align-items-center">
        <a href="/" class="d-flex align-items-center text-white text-decoration-none">
            <img src="images/logo_giallo.png" alt="Logo sito" width="32">
            <span class="ms-2">Home</span>
        </a>
    </div>
</header>

<main class="form-signin w-100" id="maincontent">
    <form style="max-width: 50%; margin: 0 auto;" id="formRegistrazione" novalidate>
        <h1 class="h3 mb-3 fw-normal text-center">Registrati</h1>
        <div class="form-floating">
            <input type="text" class="form-control" id="nameInput" placeholder="nome" autocomplete="given-name" required aria-describedby="nameInputError">
            <label for="nameInput">Nome*</label>
        </div>
        <p id="nameInputError" class="error hidden">il nome è obbligatorio</p>
        <div class="form-floating">
            <input type="text" class="form-control" id="surnameInput" placeholder="cognome" autocomplete="family-name" required aria-describedby="surnameInputError">
            <label for="surnameInput">Cognome*</label>
        </div>
        <p id="surnameInputError" class="error hidden">il cognome è obbligatorio</p>
        <div class="form-floating">
            <input type="tel" class="form-control" id="telInput" placeholder="333" autocomplete="tel">
            <label for="telInput">Telefono</label>
        </div>
        <div class="form-floating">
            <input type="email" class="form-control" id="emailInput" placeholder="name@example.com" autocomplete="email" required aria-describedby="emailInputError">
            <label for="emailInput">Email*</label>
        </div>
        <p id="emailInputError" class="error hidden">l'email è obbligatoria e deve essere valida</p>
        <div class="form-floating">
            <input type="password" class="form-control" id="passwordInput" placeholder="Password" autocomplete="new-password" required aria-describedby="passwordInputError">
            <label for="passwordInput">Password*</label>
        </div>
        <p id="passwordInputError" class="error hidden">la password è obbligatoria</p>
        <div class="form-floating">
            <input type="password" class="form-control" id="passwordInputDue" placeholder="name@example.com" autocomplete="new-password" required aria-describedby="passwordInputDueError">
            <label for="passwordInputDue">Conferma Password*</label>
        </div>
        <p id="passwordInputDueError" class="error hidden">Conferma password è obbligatorio</p>
        <p>* campi obbligatori</p>
        <button class="btn btn-primary w-100 py-2" type="submit" aria-label="Registrati">Registrati</button>
    </form>
</main>
</body>
</html>