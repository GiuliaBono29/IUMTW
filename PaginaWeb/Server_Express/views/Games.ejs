<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Football&CO</title>
    <!--CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet">
    <!--JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="javascripts/Games.js"></script>
</head>

<body>
<!--Headers -->
<header class="p-3 text-bg-dark">
    <div class="container">
        <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-lg-start">
            <a href="/" class="d-flex align-items-center mb-2 mb-lg-0 text-white text-decoration-none">
                <img src="images/logo_giallo.png" alt="Logo sito" width="32">
            </a>

            <ul class="nav col-12 col-lg-auto me-lg-auto mb-2 justify-content-center mb-md-0">
                <li><a href="/" class="nav-link px-2 text-white">Home</a></li>
                <li><a href="/Games" class="nav-link px-2 text-white">Partite</a></li>
                <li>
                    <div class="dropdown text-end">
                        <a href="#" class="nav-link px-2 text-white" data-bs-toggle="dropdown" aria-expanded="false">Statistiche</a>
                        <ul class="dropdown-menu text-small" style="">
                            <li><a class="dropdown-item" href="/Goal_xG">xG (Goal previsti)</a></li>
                            <li><a class="dropdown-item" href="#">Goal Over/Under</a></li>
                            <li><a class="dropdown-item" href="/Goal_BTTS">Statistiche BTTS</a></li>
                            <li><a class="dropdown-item" href="#">Goal 1°/2° Tempo</a></li>
                            <li><a class="dropdown-item" href="#">Goal in entrambi i tempi</a></li>
                            <li><a class="dropdown-item" href="#">Calci d'angolo</a></li>
                            <li><a class="dropdown-item" href="#">Cartellini</a></li>
                            <li><a class="dropdown-item" href="#">Scarica CSV</a></li>
                        </ul>
                    </div>
                </li>
                <li><a href="/Players" class="nav-link px-2 text-white">Calciatori</a></li>
                <li><a href="/Teams" class="nav-link px-2 text-white">Squadre</a></li>
                <li>
                    <div class="dropdown text-end">
                        <a href="#" class="nav-link px-2 text-white" data-bs-toggle="dropdown" aria-expanded="false">Campionati</a>
                        <ul class="dropdown-menu text-small" style="">
                            <li><a class="dropdown-item" href="/Champions_League">Champions League</a></li>
                            <li><a class="dropdown-item" href="/Premier_League">Premier League</a></li>
                            <li><a class="dropdown-item" href="/Serie_A">Serie A</a></li>
                            <li><a class="dropdown-item" href="/LaLiga">LaLiga</a></li>
                        </ul>
                    </div>
                </li>
                <li><a href="#" class="nav-link px-2 text-white">Forum</a></li>
                <li><a href="#" class="nav-link px-2 text-white">Chi siamo</a></li>
            </ul>

            <form class="col-12 col-lg-auto mb-3 mb-lg-0 me-lg-3" role="search">
                <input type="search" class="form-control form-control-dark" placeholder="Ricerca..." aria-label="Search">
            </form>

            <div class="text-end">
                <a href="/login" class="btn btn-outline-light me-2">Login</a>
                <a href="/signup" class="btn btn-secondary">Sign-up</a>
            </div>
        </div>
    </div>
</header>

<!--Main body -->
<div class="container my-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb p-3 bg-body-tertiary rounded-3">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Partite</li>
        </ol>
    </nav>
</div>

<main class="container">
    <div class="p-4 p-md-5 mb-4 rounded text-body-emphasis bg-body-tertiary">
        <div class="row">
            <div class="feature col" style="flex: 0 0 10%;">
                <span class="fs-4">Filtri</span>
                <hr>
                <ul class="nav nav-pills flex-column mb-auto">
                    <li class="my-1">
                        <label for="championship" class="mb-3">Campionato</label>
                        <select class="form-select" id="championship" required="">
                            <option value="">Scegli...</option>
                            <option>Champions League</option>
                            <option>Premier League</option>
                            <option>Serie A</option>
                            <option>La Liga</option>
                        </select>
                    </li>
                    <li class="my-1">
                        <label for="state" class="mb-3">Nazione</label>
                        <select class="form-select" id="state" required="">
                            <option value="">Scegli...</option>
                            <option>Austria</option>
                            <option>Belgio</option>
                            <option>Bulgaria</option>
                            <option>Cipro</option>
                            <option>Croazia</option>
                            <option>Danimarca</option>
                            <option>Estonia</option>
                            <option>Finlandia</option>
                            <option>Francia</option>
                            <option>Germania</option>
                            <option>Grecia</option>
                            <option>Irlanda</option>
                            <option>Italia</option>
                            <option>Lettonia</option>
                            <option>Lituania</option>
                            <option>Lussemburgo</option>
                            <option>Malta</option>
                            <option>Paesi Bassi</option>
                            <option>Polonia</option>
                            <option>Portogallo</option>
                            <option>Repubblica Ceca</option>
                            <option>Romania</option>
                            <option>Slovacchia</option>
                            <option>Slovenia</option>
                            <option>Spagna</option>
                            <option>Svezia</option>
                            <option>Ungheria</option>
                        </select>
                    </li>
                    <li class="my-1">
                        <label for="team" class="mb-3">Squadra</label>
                        <select class="form-select" id="team" required="">
                            <option value="">Scegli...</option>
                            <option>Atalanta</option>
                            <option>Bari</option>
                            <option>Bologna</option>
                            <option>Brescia</option>
                            <option>Cagliari</option>
                            <option>Catania</option>
                            <option>Chievo Verona</option>
                            <option>Cremonese</option>
                            <option>Empoli</option>
                            <option>Fiorentina</option>
                            <option>Genoa</option>
                            <option>Hellas Verona</option>
                            <option>Inter</option>
                            <option>Juventus</option>
                            <option>Lazio</option>
                            <option>Lecce</option>
                            <option>Milan</option>
                            <option>Napoli</option>
                            <option>Palermo</option>
                            <option>Parma</option>
                            <option>Perugia</option>
                            <option>Pescara</option>
                            <option>Sampdoria</option>
                            <option>Sassuolo</option>
                            <option>Torino</option>
                            <option>Udinese</option>
                        </select>
                    </li>
                </ul>
                <hr>
                <button class="btn btn-primary btn-lg" type="submit">conferma</button>
            </div>

            <div class="feature col" style="flex: 0 0 85%;">
                <h1>Ultime partite</h1>
                <div class="table-responsive small">
                    <table class="table table-striped table-sm">
                        <thead>
                        <tr>
                            <th scope="col">Squadra di casa</th>
                            <th scope="col">Squadra ospite</th>
                            <th scope="col">Punteggio</th>
                            <th scope="col">Data</th>
                            <th scope="col">Campionato</th>
                        </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</main>

<!--Footer -->
<footer class="py-5 text-center text-body bg-body-tertiary">
    <img src="images/logo_giallo.png" alt="Logo sito" width="32">
    <p>Sito sviluppato da <a href="andrea.argentero347@edu.unito.it">Andrea Argentero</a> e <a href="giulia.bono116@edu.unito.it">Giulia Bono</a>.</p>
    <p class="mb-0">
        <a href="#">Torna su</a>
    </p>
</footer>

</body>
</html>